{
  "openapi": "3.0.3",
  "info": {
    "title": "煤炭销售管理系统 API",
    "description": "煤炭销售管理系统前后端分离接口文档（RESTful）。所有接口统一返回 Result 结构：{code, message, data}。除登录外均需携带 Authorization: Bearer <token>。",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:8080/api", "description": "开发环境" }
  ],
  "tags": [
    { "name": "认证管理", "description": "登录、退出、修改密码" },
    { "name": "客户管理", "description": "客户档案 CRUD" },
    { "name": "商品管理", "description": "煤种商品 CRUD" },
    { "name": "数据字典", "description": "业务参数维护" },
    { "name": "合同管理", "description": "合同录入、提交、审核" },
    { "name": "订单管理", "description": "销售订单 CRUD 与取消" },
    { "name": "磅单管理", "description": "称重发运：建单、录皮重、录毛重、作废" },
    { "name": "库存管理", "description": "库存查询、流水、入库、盘点" },
    { "name": "结算管理", "description": "结算单生成、审核、作废" },
    { "name": "回款管理", "description": "回款登记与核销" },
    { "name": "报表统计", "description": "销售趋势、排行、回款率、库存预警" },
    { "name": "系统管理", "description": "用户、角色、菜单、日志" }
  ],
  "components": {
    "schemas": {
      "Result": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "description": "200成功；400参数错误；401未认证；403越权；404不存在；500系统异常；1001业务异常；1002状态非法", "example": 200 },
          "message": { "type": "string", "example": "操作成功" },
          "data": { "description": "业务数据" }
        }
      },
      "PageResult": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "message": { "type": "string", "example": "操作成功" },
          "data": {
            "type": "object",
            "properties": {
              "records": { "type": "array", "items": { "type": "object" } },
              "total": { "type": "integer", "example": 120 },
              "page": { "type": "integer", "example": 1 },
              "size": { "type": "integer", "example": 10 }
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "password": { "type": "string", "example": "123456" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiJ9..." },
          "userInfo": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "example": 1 },
              "username": { "type": "string", "example": "admin" },
              "realName": { "type": "string", "example": "系统管理员" },
              "roleCode": { "type": "string", "example": "ADMIN" },
              "menus": { "type": "array", "items": { "type": "string" }, "example": ["/dashboard", "/system/user"] }
            }
          }
        }
      },
      "CustomerRequest": {
        "type": "object",
        "required": ["customerName"],
        "properties": {
          "customerName": { "type": "string", "description": "客户单位名称", "example": "华能某电厂" },
          "contactName": { "type": "string", "example": "王经理" },
          "phone": { "type": "string", "example": "13800000001" },
          "address": { "type": "string", "example": "内蒙古鄂尔多斯市" },
          "invoiceInfo": { "type": "string", "description": "开票信息", "example": "税号 9115..." },
          "creditLimit": { "type": "number", "description": "信用额度（元）", "example": 500000 },
          "region": { "type": "string", "example": "内蒙古" },
          "remark": { "type": "string" }
        }
      },
      "ProductRequest": {
        "type": "object",
        "required": ["productName"],
        "properties": {
          "productName": { "type": "string", "description": "煤种名称", "example": "烟煤" },
          "spec": { "type": "string", "description": "规格", "example": "末煤" },
          "qnetAr": { "type": "integer", "description": "收到基低位发热量 kcal/kg", "example": 5500 },
          "sulfur": { "type": "number", "description": "硫分 %", "example": 1.2 },
          "ash": { "type": "number", "description": "灰分 %", "example": 18 },
          "origin": { "type": "string", "example": "内蒙古鄂尔多斯" },
          "basePrice": { "type": "number", "description": "基准价 元/吨", "example": 520 },
          "safeStock": { "type": "number", "description": "安全库存 吨", "example": 1500 },
          "status": { "type": "integer", "description": "1上架 0下架", "example": 1 },
          "remark": { "type": "string" }
        }
      },
      "ContractRequest": {
        "type": "object",
        "required": ["customerId", "productId", "totalQty", "price"],
        "properties": {
          "customerId": { "type": "integer", "example": 1 },
          "productId": { "type": "integer", "example": 1 },
          "signDate": { "type": "string", "format": "date", "example": "2026-10-26" },
          "startDate": { "type": "string", "format": "date", "example": "2026-11-01" },
          "endDate": { "type": "string", "format": "date", "example": "2027-10-31" },
          "totalQty": { "type": "number", "description": "约定总量 吨", "example": 5000 },
          "price": { "type": "number", "description": "含税单价 元/吨", "example": 520 },
          "taxRate": { "type": "number", "description": "税率 %", "example": 13 },
          "qnetAr": { "type": "integer", "description": "约定热值", "example": 5500 },
          "shortRate": { "type": "number", "description": "溢短装比例 %", "example": 5 },
          "payType": { "type": "integer", "description": "1预付 2货到付款 3账期", "example": 3 },
          "creditDays": { "type": "integer", "description": "账期天数", "example": 30 },
          "transportBear": { "type": "integer", "description": "1客户自提 2供方送货", "example": 1 }
        }
      },
      "AuditRequest": {
        "type": "object",
        "required": ["pass"],
        "properties": {
          "pass": { "type": "boolean", "example": true },
          "opinion": { "type": "string", "example": "同意执行" }
        }
      },
      "OrderRequest": {
        "type": "object",
        "required": ["contractId", "planQty"],
        "properties": {
          "contractId": { "type": "integer", "description": "合同 id（必填）", "example": 8 },
          "planQty": { "type": "number", "description": "计划数量 吨", "example": 300 },
          "price": { "type": "number", "description": "价格快照，默认合同价", "example": 520 },
          "priceRemark": { "type": "string", "description": "手动改价理由", "example": "" },
          "deliveryDate": { "type": "string", "format": "date", "example": "2026-11-05" },
          "plateNo": { "type": "string", "example": "晋B12345" }
        }
      },
      "OrderUpdateRequest": {
        "type": "object",
        "description": "只传要改的字段。合同/客户/煤种不可改；计划量不得小于已发运量；改价必须填 priceRemark",
        "properties": {
          "planQty": { "type": "number", "example": 350 },
          "price": { "type": "number", "example": 515 },
          "priceRemark": { "type": "string", "example": "客户加量议价" },
          "deliveryDate": { "type": "string", "format": "date" },
          "plateNo": { "type": "string" }
        }
      },
      "TicketCreateRequest": {
        "type": "object",
        "required": ["orderId", "plateNo"],
        "properties": {
          "orderId": { "type": "integer", "description": "订单 id（必填，磅单必须挂订单）", "example": 15 },
          "plateNo": { "type": "string", "example": "晋B12345" },
          "driver": { "type": "string", "example": "张三" },
          "tareSource": { "type": "integer", "description": "1现场称重 2备案套用", "example": 1 }
        }
      },
      "TareRequest": {
        "type": "object",
        "required": ["tareWeight"],
        "properties": {
          "tareWeight": { "type": "number", "description": "皮重 吨", "example": 16.8 },
          "tareTime": { "type": "string", "example": "2026-10-26 09:15:00" }
        }
      },
      "GrossRequest": {
        "type": "object",
        "required": ["grossWeight"],
        "properties": {
          "grossWeight": { "type": "number", "description": "毛重 吨", "example": 49.85 },
          "grossTime": { "type": "string", "example": "2026-10-26 10:30:00" }
        }
      },
      "CancelReasonRequest": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": { "type": "string", "description": "作废/取消原因（必填）", "example": "毛重录入错误" }
        }
      },
      "SettlementCreateRequest": {
        "type": "object",
        "required": ["contractId", "ticketIds"],
        "properties": {
          "contractId": { "type": "integer", "example": 8 },
          "ticketIds": {
            "type": "array",
            "description": "勾选的已完成未结算磅单 id",
            "items": { "type": "integer" },
            "example": [101, 102, 103]
          }
        }
      },
      "PaymentRequest": {
        "type": "object",
        "required": ["customerId", "amount"],
        "properties": {
          "customerId": { "type": "integer", "example": 1 },
          "amount": { "type": "number", "example": 50000 },
          "payType": { "type": "integer", "description": "1银行转账 2现金 3承兑汇票", "example": 1 },
          "payTime": { "type": "string", "example": "2026-10-26 14:00:00" },
          "remark": { "type": "string", "example": "银行回单号 20261026-001" }
        }
      },
      "WriteOffRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "description": "核销明细，合计不得超过回款金额",
            "items": {
              "type": "object",
              "properties": {
                "settleId": { "type": "integer", "example": 20 },
                "amount": { "type": "number", "example": 30000 }
              }
            }
          }
        }
      },
      "StockChangeRequest": {
        "type": "object",
        "required": ["productId", "changeQty"],
        "properties": {
          "productId": { "type": "integer", "example": 1 },
          "changeQty": { "type": "number", "description": "变动数量 吨，入库为正、盘亏为负", "example": 200 },
          "remark": { "type": "string", "example": "矿上进货" }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Bearer <token>"
      }
    }
  },
  "security": [ { "Bearer": [] } ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["认证管理"],
        "summary": "登录",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Result" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/LoginResponse" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "description": "密码错误次数超限锁定，或账号密码错误" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["认证管理"],
        "summary": "退出登录",
        "responses": { "200": { "description": "成功，data 为空" } }
      }
    },
    "/users/{id}/password": {
      "put": {
        "tags": ["认证管理"],
        "summary": "修改密码",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["oldPassword", "newPassword"],
                "properties": {
                  "oldPassword": { "type": "string", "example": "123456" },
                  "newPassword": { "type": "string", "description": "长度≥8", "example": "abc12345" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/customers": {
      "get": {
        "tags": ["客户管理"],
        "summary": "分页查询",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" }, "description": "名称关键字" },
          { "name": "region", "in": "query", "schema": { "type": "string" } },
          { "name": "onlyMine", "in": "query", "schema": { "type": "boolean" }, "description": "只看我的（C2 归属人筛选）" }
        ],
        "responses": { "200": { "description": "分页结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageResult" } } } } }
      },
      "post": {
        "tags": ["客户管理"],
        "summary": "新增客户",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerRequest" } } } },
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/customers/{id}": {
      "get": {
        "tags": ["客户管理"],
        "summary": "客户详情",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" }, "404": { "description": "不存在" } }
      },
      "put": {
        "tags": ["客户管理"],
        "summary": "修改客户",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerRequest" } } } },
        "responses": { "200": { "description": "成功" } }
      },
      "delete": {
        "tags": ["客户管理"],
        "summary": "删除客户（逻辑删除）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" }, "1001": { "description": "该客户存在关联单据，不可删除" } }
      }
    },
    "/products": {
      "get": {
        "tags": ["商品管理"],
        "summary": "分页查询",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "integer", "description": "1上架 0下架" } }
        ],
        "responses": { "200": { "description": "分页结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageResult" } } } } }
      },
      "post": {
        "tags": ["商品管理"],
        "summary": "新增煤种商品",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductRequest" } } } },
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": ["商品管理"],
        "summary": "商品详情",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" } }
      },
      "put": {
        "tags": ["商品管理"],
        "summary": "修改商品",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductRequest" } } } },
        "responses": { "200": { "description": "成功" } }
      },
      "delete": {
        "tags": ["商品管理"],
        "summary": "删除商品（逻辑删除）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/dicts": {
      "get": {
        "tags": ["数据字典"],
        "summary": "分页查询",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "dictType", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "分页结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageResult" } } } } }
      },
      "post": {
        "tags": ["数据字典"],
        "summary": "新增字典项",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["dictType", "dictKey", "dictValue"],
                "properties": {
                  "dictType": { "type": "string", "example": "biz_param" },
                  "dictKey": { "type": "string", "example": "order_over_delivery_rate" },
                  "dictValue": { "type": "string", "example": "0.03" },
                  "remark": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/dicts/type/{type}": {
      "get": {
        "tags": ["数据字典"],
        "summary": "按类型取全部键值（前端下拉/参数读取）",
        "parameters": [ { "name": "type", "in": "path", "required": true, "schema": { "type": "string", "example": "biz_param" } } ],
        "responses": { "200": { "description": "键值对列表" } }
      }
    },
    "/dicts/{id}": {
      "put": {
        "tags": ["数据字典"],
        "summary": "修改字典项",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "dictValue": { "type": "string" }, "remark": { "type": "string" } } } } } },
        "responses": { "200": { "description": "成功" } }
      },
      "delete": {
        "tags": ["数据字典"],
        "summary": "删除字典项（逻辑删除）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/contracts": {
      "get": {
        "tags": ["合同管理"],
        "summary": "分页查询（列表带剩余可下单量）",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "status", "in": "query", "schema": { "type": "integer", "description": "0草稿 1待审核 2执行中 3已完成 4已终止" } },
          { "name": "customerId", "in": "query", "schema": { "type": "integer" } },
          { "name": "productId", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "分页结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageResult" } } } } }
      },
      "post": {
        "tags": ["合同管理"],
        "summary": "新建合同（保存为草稿）",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContractRequest" } } } },
        "responses": { "200": { "description": "成功，返回合同 id" } }
      }
    },
    "/contracts/{id}": {
      "get": {
        "tags": ["合同管理"],
        "summary": "合同详情（含客户/煤种信息）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" } }
      },
      "put": {
        "tags": ["合同管理"],
        "summary": "修改合同（仅草稿/被退回可改）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContractRequest" } } } },
        "responses": { "200": { "description": "成功" }, "1002": { "description": "当前状态不允许修改" } }
      },
      "delete": {
        "tags": ["合同管理"],
        "summary": "删除合同（仅草稿可删）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" }, "1002": { "description": "仅草稿可删除" } }
      }
    },
    "/contracts/{id}/submit": {
      "post": {
        "tags": ["合同管理"],
        "summary": "提交审核（草稿→待审核）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/contracts/{id}/audit": {
      "post": {
        "tags": ["合同管理"],
        "summary": "审核合同（待审核→执行中/驳回）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuditRequest" } } } },
        "responses": { "200": { "description": "成功" }, "403": { "description": "仅销售经理可审核；不得审核本人创建的合同" } }
