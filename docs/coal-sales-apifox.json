    "/orders": {
      "get": {
        "tags": ["订单管理"],
        "summary": "分页查询",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "status", "in": "query", "schema": { "type": "integer", "description": "1待发运 2部分发运 3已完成 4已取消" } },
          { "name": "customerId", "in": "query", "schema": { "type": "integer" } },
          { "name": "contractId", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "分页结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageResult" } } } } }
      },
      "post": {
        "tags": ["订单管理"],
        "summary": "新建订单（校验合同余量与信用额度）",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderRequest" } } } },
        "responses": {
          "200": { "description": "成功" },
          "1001": { "description": "合同剩余量不足 / 客户信用额度超限（订单标记超信用待审批）" }
        }
      }
    },
    "/orders/available": {
      "get": {
        "tags": ["订单管理"],
        "summary": "可过磅订单列表（待发运/部分发运，磅房选单用）",
        "responses": { "200": { "description": "订单列表" } }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": ["订单管理"],
        "summary": "订单详情（含合同、磅单列表）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" } }
      },
      "put": {
        "tags": ["订单管理"],
        "summary": "修改订单（计划量/单价/发货日期/车牌）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderUpdateRequest" } } } },
        "responses": {
          "200": { "description": "成功" },
          "1001": { "description": "计划量不得小于已发运量 / 合同余量不足（排除本单原量）" },
          "1002": { "description": "已完成/已取消订单不可修改" }
        }
      }
    },
    "/orders/{id}/cancel": {
      "post": {
        "tags": ["订单管理"],
        "summary": "取消订单（仅未发运；已发运不可取消）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "成功" }, "1002": { "description": "已产生磅单，不可取消" } }
      }
    },
    "/weigh-tickets": {
      "get": {
        "tags": ["磅单管理"],
        "summary": "分页查询",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "status", "in": "query", "schema": { "type": "integer", "description": "0待称皮重 1已称皮重 2已完成 3已作废" } },
          { "name": "orderId", "in": "query", "schema": { "type": "integer" } },
          { "name": "plateNo", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "分页结果", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageResult" } } } } }
      },
      "post": {
        "tags": ["磅单管理"],
        "summary": "新建磅单（磅房选订单后创建）",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketCreateRequest" } } } },
        "responses": { "200": { "description": "成功，返回磅单 id" } }
      }
    },
    "/weigh-tickets/available": {
      "get": {
        "tags": ["磅单管理"],
        "summary": "可结算磅单列表（已完成且未结算，销售员做结算用）",
        "parameters": [
          { "name": "contractId", "in": "query", "required": true, "schema": { "type": "integer" }, "description": "按合同筛选" }
        ],
        "responses": { "200": { "description": "磅单列表" } }
      }
    },
    "/weigh-tickets/{id}/tare": {
      "put": {
        "tags": ["磅单管理"],
        "summary": "录皮重（待称皮重→已称皮重）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TareRequest" } } } },
        "responses": { "200": { "description": "成功" } }
      }
    },
    "/weigh-tickets/{id}/gross": {
      "put": {
        "tags": ["磅单管理"],
        "summary": "录毛重（核心事务：算净重→扣库存→写流水→累加订单发运量）",
        "description": "净重=毛重−皮重，校验 20~40 吨区间；同事务完成磅单置完成、扣库存、写库存流水、订单已发运量累加；超发超阈值转待审批",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GrossRequest" } } } },
        "responses": {
          "200": { "description": "成功" },
          "1001": { "description": "毛重小于皮重 / 净重超出合理区间" }
        }
      }
    },
    "/weigh-tickets/{id}/cancel": {
      "post": {
        "tags": ["磅单管理"],
        "summary": "作废磅单（仅未结算可作废，自动回滚库存与发运量）",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CancelReasonRequest" } } } },
        "responses": {
          "200": { "description": "成功" },
          "1002": { "description": "已进入结算单，不可作废（需先撤销结算单）" }
        }
      }
    },
